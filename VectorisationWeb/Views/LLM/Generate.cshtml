@model EmbeddingService.Models.LLMRequest
@{
    ViewData["Title"] = "Generate Text";
}

<h1>Generate Text</h1>
<p class="text-muted">Enter a prompt to generate text using the LLM</p>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">LLM Services</a></li>
        <li class="breadcrumb-item active" aria-current="page">Generate</li>
    </ol>
</nav>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Generate" method="post">
                    <div class="mb-3">
                        <label asp-for="Prompt" class="form-label">Prompt</label>
                        <textarea asp-for="Prompt" class="form-control" rows="5" 
                                  placeholder="Enter your prompt here... e.g., 'Write a short poem about programming'"></textarea>
                        <span asp-validation-for="Prompt" class="text-danger"></span>
                    </div>
                    
                    <div class="accordion mb-3" id="optionsAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" 
                                        data-bs-toggle="collapse" data-bs-target="#collapseOptions">
                                    Advanced Options
                                </button>
                            </h2>
                            <div id="collapseOptions" class="accordion-collapse collapse" 
                                 data-bs-parent="#optionsAccordion">
                                <div class="accordion-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label asp-for="Options.Temperature" class="form-label">
                                                    Temperature
                                                    <small class="text-muted">(0.0 - 2.0)</small>
                                                </label>
                                                <input asp-for="Options.Temperature" type="number" 
                                                       class="form-control" step="0.1" min="0" max="2" value="0.7" />
                                                <small class="form-text text-muted">
                                                    Higher values make output more random
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label asp-for="Options.TopP" class="form-label">
                                                    Top P
                                                    <small class="text-muted">(0.0 - 1.0)</small>
                                                </label>
                                                <input asp-for="Options.TopP" type="number" 
                                                       class="form-control" step="0.05" min="0" max="1" value="0.9" />
                                                <small class="form-text text-muted">
                                                    Nucleus sampling threshold
                                                </small>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="mb-3">
                                                <label asp-for="Options.MaxTokens" class="form-label">
                                                    Max Tokens
                                                </label>
                                                <input asp-for="Options.MaxTokens" type="number" 
                                                       class="form-control" min="1" max="4096" value="2000" />
                                                <small class="form-text text-muted">
                                                    Maximum response length
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-primary">
                        <span class="spinner-border spinner-border-sm d-none" role="status"></span>
                        Generate
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="card-title">Tips</h6>
                <ul class="small mb-0">
                    <li>Be specific in your prompts for better results</li>
                    <li>Lower temperature (0.1-0.3) for factual responses</li>
                    <li>Higher temperature (0.7-1.0) for creative content</li>
                    <li>Response time depends on prompt complexity</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelector('form').addEventListener('submit', function() {
            var btn = document.querySelector('button[type="submit"]');
            btn.querySelector('.spinner-border').classList.remove('d-none');
            btn.disabled = true;
        });
    </script>
}
