@model List<VectorisationWeb.Controllers.LLMModelInfo>
@{
    ViewData["Title"] = "Available Models";
}

<h1>Available LLM Models</h1>
<p class="text-muted">Models currently installed on the Ollama server</p>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">LLM Services</a></li>
        <li class="breadcrumb-item active" aria-current="page">Models</li>
    </ol>
</nav>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        <h5 class="alert-heading">No models found</h5>
        <p class="mb-0">
            There are no models currently installed on the Ollama server. 
            You can pull models using the command: <code>ollama pull model-name</code>
        </p>
    </div>
}
else
{
    <div class="row">
        @foreach (var llmModel in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="card-title mb-0">@llmModel.Name</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Model</dt>
                            <dd class="col-sm-8 text-truncate" title="@llmModel.Model">@llmModel.Model</dd>
                            
                            <dt class="col-sm-4">Size</dt>
                            <dd class="col-sm-8">@FormatSize(llmModel.Size)</dd>
                            
                            <dt class="col-sm-4">Modified</dt>
                            <dd class="col-sm-8">@llmModel.ModifiedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <small class="text-muted text-truncate d-block" title="@llmModel.Digest">
                            Digest: @(llmModel.Digest.Length > 20 ? llmModel.Digest.Substring(0, 20) + "..." : llmModel.Digest)
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="mt-3">
        <p class="text-muted">
            <strong>Total Models:</strong> @Model.Count
        </p>
    </div>
}

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to LLM Services</a>
    <button class="btn btn-outline-primary" onclick="location.reload()">
        Refresh
    </button>
</div>

@functions {
    string FormatSize(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int suffixIndex = 0;
        double size = bytes;
        
        while (size >= 1024 && suffixIndex < suffixes.Length - 1)
        {
            size /= 1024;
            suffixIndex++;
        }
        
        return $"{size:F2} {suffixes[suffixIndex]}";
    }
}
